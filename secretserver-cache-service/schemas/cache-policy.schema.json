{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secretserver.io/schemas/cache-policy-v1.json",
  "title": "SecretServer offline cache policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "tenant_id", "policy_id", "policy_version", "device_id", "lease_id", "sequence", "issued_at", "not_before", "expires_at", "assurance", "delivery_modes", "resources"],
  "properties": {
    "version": {"const": 1},
    "tenant_id": {"type": "string", "format": "uuid"},
    "policy_id": {"type": "string", "format": "uuid"},
    "policy_version": {"type": "integer", "minimum": 1},
    "device_id": {"type": "string", "format": "uuid"},
    "lease_id": {"type": "string", "format": "uuid"},
    "sequence": {"type": "integer", "minimum": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "not_before": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "assurance": {"enum": ["standard", "hardware"]},
    "delivery_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["plaintext_read", "child_process_pipe"]}},
    "max_entries": {"type": "integer", "minimum": 1},
    "max_encrypted_bytes": {"type": "integer", "minimum": 1},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_type", "resource_id", "version", "record_digest"],
        "properties": {
          "resource_type": {"type": "string", "minLength": 1, "maxLength": 64},
          "resource_id": {"type": "string", "minLength": 1, "maxLength": 512},
          "version": {"type": "integer", "minimum": 1},
          "record_digest": {"type": "string", "pattern": "^[A-Za-z0-9_-]{43}$"}
        }
      }
    }
  }
}
